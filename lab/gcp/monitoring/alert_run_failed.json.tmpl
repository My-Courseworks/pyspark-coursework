{
  "displayName": "ShopCo pipeline run failed",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "shopco_run_failures > 0 in 5 min",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/shopco_run_failures\" AND resource.type=\"cloud_dataproc_batch\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "0s",
        "aggregations": [
          {"alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM"}
        ],
        "trigger": {"count": 1}
      }
    }
  ],
  "notificationChannels": ["__CHANNEL__"],
  "alertStrategy": {"autoClose": "1800s"},
  "documentation": {
    "content": "A ShopCo Dataproc Serverless batch printed SHOPCO_RUN with status=failed. Open the batch in Dataproc > Batches, read the failing SHOPCO_STEP line (it carries the exception), and the run's report.md under gs://<bucket>/runs/<batch id>/.",
    "mimeType": "text/markdown"
  }
}
